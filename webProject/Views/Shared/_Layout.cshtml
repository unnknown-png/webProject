@{
    var title = ViewData["Title"] as string ?? "Gauss Solver";
    var theme = Context.Request.Cookies["theme"] ?? "dark"; // default to dark
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="Simple Gauss solver demo." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("HeadContent", required: false)
</head>
<body data-theme="@theme">
<!-- Full-width topbar (sticky) -->
<header class="topbar" role="banner">
    <div class="topbar-inner">
        <div class="topbar-left">
            <div class="brand">Gauss Solver</div>
            <nav class="topnav" aria-label="Main navigation">
                <a class="nav-link" href="@Url.Action("Index","Home")" id="homeLink">Home</a>
                <a class="nav-link" href="#history-section">History</a>
            </nav>
        </div>

        <div class="topbar-right">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <span class="hint">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline; margin-left:8px;">
                    @Html.AntiForgeryToken()
                    <button class="btn" type="submit">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn login">Log In</a>
                <a asp-controller="Account" asp-action="Register" class="btn register primary">Register</a>
            }
        </div>
    </div>
</header>

<div class="site-body">
    @RenderBody()
</div>

<!-- Global full-width footer -->
<footer class="site-footer-global" role="contentinfo">
    <div class="site-footer-inner">
        <div class="footer-left">
            <strong>Gauss Solver</strong> — demo version for education. Created by Andrew Kahnovets.
        </div>
        <div class="footer-right">
            <small>Version 0.2 • <a href="mailto:kahnovets.ap@gmail.com">kahnovets.ap@gmail.com</a></small>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true" defer></script>
@RenderSection("Scripts", required: false)
</body>
</html>

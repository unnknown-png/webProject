@{
	ViewData["Title"] = "Home";
}

<div class="wrap" id="home-wrap" role="application">
	<header class="site-header" role="banner">
		<div>
			<h1>Home</h1>
		</div>
	</header>

	<div class="controls" role="region" aria-label="Контролі матриці">
		<div class="controls-left">
			<label for="sizeInput" class="hint">Matrix size (2-4000)</label>
			<input id="sizeInput" type="number" min="2" max="4000" value="5" aria-label="matrix size input" required />
			<span id="sizeError" class="hint error-message" style="display: none; color: #ff6b6b;"></span>

			<div class="controls-group">
				<button id="rand" title="Заповнити випадково">Random</button>
				<button id="clear" title="Очистити матрицю">Clear</button>
				<button id="solve" class="primary" title="Розв'язати систему">Solve</button>
			</div>
		</div>

		<div class="controls-right">
			<button id="themeToggle" title="Перемкнути тему">Toggle theme</button>
		</div>
	</div>

	<main class="main" role="main">
		<div id="queue-tasks-container" class="queue-tasks-container" style="display: none;">
		</div>

		<section id="matrix-section" class="panel matrix-panel" aria-labelledby="matrix-title">
			<div class="panel-head">
				<strong id="matrix-title">Matrix and vector of the right sides</strong>
				<small class="hint">Enter numbers manually or use Random</small>
			</div>

		<div class="matrix-wrap" id="matrixWrap" aria-live="polite">
		</div>

		<div id="tasksContainer" class="tasks-container">
		</div>

		<div id="result" class="result" hidden></div>
	</section>

	</main>
</div>

<div class="wrap" id="history-wrap" role="application">
	<header class="site-header" role="banner" aria-hidden="false">
		<div>
			<h2>History</h2>
		</div>
	</header>
	<section id="history-section" class="history-container panel" aria-labelledby="history-title">
		<div class="history-list" id="history"></div>

		<div class="history-controls">
			<button id="clearHistory" class="danger">Clear history</button>
			<button id="export" title="Export history">Export</button>
		</div>
	</section>
</div>


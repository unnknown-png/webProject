@{
    var title = ViewData["Title"] as string ?? "Gauss Solver";
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="Простий розв'язувач систем лінійних алгебраїчних рівнянь методом Гаусса (демо)." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("HeadContent", required: false)
</head>
<body>
<!-- Full-width topbar (sticky) -->
<header class="topbar" role="banner">
    <div class="topbar-inner">
        <div class="topbar-left">
            <div class="brand">Gauss Solver</div>
            <nav class="topnav" aria-label="Головна навігація">
                <a class="nav-link" href="@Url.Action("Index","Home")" id="homeLink">Home</a>
                <a class="nav-link" href="#history-section">History</a>
            </nav>
        </div>

        <div class="topbar-right">
            <button class="btn login">Увійти</button>
            <button class="btn register primary">Зареєструватись</button>
        </div>
    </div>
</header>

<div class="site-body">
    @RenderBody()
</div>

<!-- Global full-width footer -->
<footer class="site-footer-global" role="contentinfo">
    <div class="site-footer-inner">
        <div class="footer-left">
            <strong>Gauss Solver</strong> — demo version for education. Created by Andrew Kahnovets.
        </div>
        <div class="footer-right">
            <small>Version 0.1 • <a href="mailto:kahnovets.ap@gmail.com">kahnovets.ap@gmail.com</a></small>
        </div>
    </div>
</footer>

<script src="~/js/site.js" asp-append-version="true" defer></script>
@RenderSection("Scripts", required: false)
</body>
</html>

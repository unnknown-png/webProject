@model webProject.Models.RegisterViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Register";
}


<div class="wrap auth-panel panel">
    <div class="site-header">
        <h1>Gauss Solver</h1>
        <div class="subtitle">Create an account for a better experience</div>
    </div>

    <form asp-action="Register" method="post">
        <div class="field-row">
            <label asp-for="Email"></label>
            <input asp-for="Email" />
            <span class="hint" asp-validation-for="Email"></span>
        </div>

        <div class="field-row">
            <label asp-for="Password"></label>
            <div class="password-wrapper">
                <input asp-for="Password" id="registerPassword" />
                <button type="button" class="toggle-password" onclick="togglePassword('registerPassword', this)" aria-label="Show password">
                    Show
                </button>
            </div>
            <span class="hint" asp-validation-for="Password"></span>
        </div>

        <div class="field-row">
            <label asp-for="ConfirmPassword"></label>
            <div class="password-wrapper">
                <input asp-for="ConfirmPassword" id="confirmPassword" />
                <button type="button" class="toggle-password" onclick="togglePassword('confirmPassword', this)" aria-label="Show password">
                    Show
                </button>
            </div>
            <span class="hint" asp-validation-for="ConfirmPassword"></span>
        </div>

        <div class="auth-actions">
            <div class="left"><a class="btn" href="@Url.Action("Login","Account")">Back to Log In</a></div>
            <div class="right"><button class="btn primary" type="submit">Register</button></div>
        </div>

        @Html.AntiForgeryToken()
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

